    {
      "name": "🔍 Games — Fuzzy Search",
      "description": "Typo-tolerant search menggunakan Levenshtein Distance + Token Matching.\n\nContoh: \"Winbing Eleven\" → \"Winning Eleven\"",
      "item": [
        {
          "name": "Search: \"Winbing Eleven\" (typo Winning)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns Winning Eleven games', function () {",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    var names = jsonData.map(g => g.name);",
                  "    var hasWinning = names.some(n => n.includes('Winning Eleven'));",
                  "    pm.expect(hasWinning).to.be.true;",
                  "});",
                  "",
                  "pm.test('Has relevance score', function () {",
                  "    pm.expect(jsonData[0]).to.have.property('relevanceScore');",
                  "    pm.expect(jsonData[0].relevanceScore).to.be.above(0.6);",
                  "});",
                  "",
                  "console.log('🔍 Search: Winbing Eleven');",
                  "jsonData.forEach(g => {",
                  "    console.log(`  → ${g.name} (score: ${g.relevanceScore.toFixed(3)})`);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/games/search?q=Winbing Eleven",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Winbing Eleven"
                }
              ]
            },
            "description": "🔍 **Typo Test: Winbing → Winning**\n\nExpected: Winning Eleven 2024, 2023, 10, 9\nRelevance score: ~0.928"
          },
          "response": []
        },
