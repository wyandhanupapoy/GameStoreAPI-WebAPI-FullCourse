{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedOrigins": [
    "https://frontend-anda.com"
  ],
  "ConnectionStrings": {
    "GameStore": "[Secret: Managed by .NET User Secrets in Local Dev / Environment Variables in Production]"
  },
  "Jwt": {
    "Key": "[Secret: Managed by .NET User Secrets in Local Dev / Environment Variables in Production]",
    "Issuer": "https://api.gamestore.local",
    "Audience": "https://web.gamestore.local"
  }
}